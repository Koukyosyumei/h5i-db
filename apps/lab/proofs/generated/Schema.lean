@[step] theorem Trial.clone_spec (x : Trial) : Trial.Insts.CoreCloneClone.clone x ⦃ y => y = x ⦄ := by
  rw [Trial.clone_eq]; simp

def Trial.putA (x : Trial) : AWrite Val := .put Trial.table Trial.keyLen (Trial.row x)

@[step] theorem Trial.sql_put_spec (x : Trial) : Trial.sql_put x ⦃ w => sqlW w = Trial.putA x ⦄ := by
  unfold Trial.sql_put; step*; simp_all [sqlW, Trial.putA, Trial.table, Trial.keyLen, Trial.TABLE, Trial.KEY_LEN]

/-- Insert, or replace the row with the same key. -/
@[step] theorem Trial.put_spec (v : alloc.vec.Vec Trial) (x : Trial) (h : v.length < Usize.max) :
    Trial.put v x ⦃ v' => v'.val = upsert (fun y => y.id) x v.val ⦄ := by
  unfold Trial.put Trial.put_loop
  apply WP.spec_mono (loop_search v.val (fun q => decide (q.id = x.id))
    (fun y : alloc.vec.Vec Trial => y.val) (fun j _ => v.val.set j x) (v.val ++ [x]) _ ?_ 0#usize (by simp))
  · intro r hr; rw [hr, show ((0#usize : Usize) : Nat) = 0 from rfl]
    exact upsert_loop_result (fun y => y.id) x _ 0 (Nat.zero_le _) (by simp)
  · intro j hj; unfold Trial.put_loop.body; h5i_step

/-- The rows without this key. -/
@[step] theorem Trial.del_spec (v : alloc.vec.Vec Trial) (id : U64) :
    Trial.del v id ⦃ v' => v'.val = v.val.filter (fun y => ¬(y.id = id)) ⦄ := by
  unfold Trial.del Trial.del_loop
  apply WP.spec_mono (loop_fold v.val (fun w : alloc.vec.Vec Trial => w.val)
    (fun acc y => if decide ¬(y.id = id) then acc ++ [y] else acc)
    (fun w j => w.length ≤ j) (fun x => Trial.del_loop.body v id x.1 x.2) ?_ _ 0#usize (by simp) (by simp))
  · intro r hr; rw [hr, foldl_filter]; simp
  · intro o j hj ho; have := v.len_ineq; unfold Trial.del_loop.body; h5i_step

/-- The rows whose column `col` does not hold `val`. -/
@[step] theorem Trial.del_where_spec (v : alloc.vec.Vec Trial) (col : U32) (val : Val) :
    Trial.del_where v col val ⦃ v' => v'.val = v.val.filter (fun y => ¬((Trial.row y)[col.val]? = some val)) ⦄ := by
  unfold Trial.del_where Trial.del_where_loop
  apply WP.spec_mono (loop_fold v.val (fun w : alloc.vec.Vec Trial => w.val)
    (fun acc y => if decide ¬((Trial.row y)[col.val]? = some val) then acc ++ [y] else acc)
    (fun w j => w.length ≤ j) (fun x => Trial.del_where_loop.body v col val x.1 x.2) ?_ _ 0#usize (by simp) (by simp))
  · intro r hr; rw [hr, foldl_filter]; simp
  · intro o j hj ho; have := v.len_ineq; unfold Trial.del_where_loop.body; h5i_step

def Trial.delA (id : U64) : AWrite Val := .del Trial.table [int id.val]
def Trial.delWhereA (col : Nat) (val : Val) : AWrite Val := .delWhere Trial.table col val

@[step] theorem Trial.sql_del_spec (id : U64) : Trial.sql_del id ⦃ w => sqlW w = Trial.delA id ⦄ := by
  unfold Trial.sql_del; step* <;> simp_all [sqlW, Trial.delA, Trial.table, Trial.TABLE] <;> scalar_tac

@[step] theorem Trial.sql_del_where_spec (col : U32) (val : Val) :
    Trial.sql_del_where col val ⦃ w => sqlW w = Trial.delWhereA col.val val ⦄ := by
  unfold Trial.sql_del_where; simp [sqlW, Trial.delWhereA, Trial.table, Trial.TABLE]

/-! Row writes on the encoding match the list operations. -/

@[simp] theorem Trial.map_put (x : Trial) (l : List Trial) :
    upsert (·.take 1) (Trial.row x) (l.map Trial.row) = (upsert (fun y => y.id) x l).map Trial.row :=
  map_upsert _ _ _ _ _ (fun y => by simp [Trial.row])

@[simp] theorem Trial.map_del (id : U64) (l : List Trial) :
    (l.map Trial.row).filter (fun r => !decide (r.take 1 = [int id.val])) =
      (l.filter (fun y => !decide (y.id = id))).map Trial.row :=
  map_filter_of _ _ _ _ (fun y => by simp [Trial.row])

@[simp] theorem Trial.map_del_where (col : Nat) (val : Val) (l : List Trial) :
    (l.map Trial.row).filter (fun r => !decide (r[col]? = some val)) =
      (l.filter (fun y => !decide ((Trial.row y)[col]? = some val))).map Trial.row := by
  rw [List.filter_map]; rfl

