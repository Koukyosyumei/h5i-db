theorem Meta.from_one_spec (rows : alloc.vec.Vec (alloc.vec.Vec Val)) (l : List Meta)
    (hl : l.length ≤ 1) (h : rows.val.map (·.val) = l.map Meta.row) :
    Meta.from_one rows ⦃ o => o = some (l.headD Meta.zero) ⦄ := by
  unfold Meta.from_one
  match l, hl with
  | [], _ =>
    have hr : rows.val = [] := by simpa using h
    have h0 : rows.len = 0#usize := by scalar_tac
    rw [if_pos h0]; step*; simp_all [Meta.zero]
  | [x], _ =>
    obtain ⟨v, hv, hvv⟩ : ∃ v, rows.val = [v] ∧ v.val = Meta.row x := by
      simp only [List.map_cons, List.map_nil] at h
      obtain ⟨v, rest⟩ := List.map_eq_singleton_iff.1 h
      exact ⟨v, rest.1, rest.2⟩
    have h0 : ¬ rows.len = 0#usize := by scalar_tac
    have h1 : rows.len = 1#usize := by scalar_tac
    rw [if_neg h0, if_pos h1]
    step as ⟨ w, hw ⟩
    have : w.val = Meta.row x := by rw [hw]; simp [hv, hvv]
    step with Meta.from_row_spec x w this
    simp_all

theorem Agent.from_rows_spec (rows : alloc.vec.Vec (alloc.vec.Vec Val)) (l : List Agent)
    (h : rows.val.map (·.val) = l.map Agent.row) :
    Agent.from_rows rows ⦃ o => ∃ v, o = some v ∧ v.val = l ⦄ := by
  have e : Agent.from_rows_loop rows (alloc.vec.Vec.new Agent) true 0#usize =
      loop (fun x => rowsBody Agent.from_row rows x.1 x.2.1 x.2.2) (alloc.vec.Vec.new Agent, true, 0#usize) := by
    unfold Agent.from_rows_loop; congr 1; funext ⟨a, b, c⟩
    simp only []; unfold Agent.from_rows_loop.body rowsBody
    dsimp only
    split <;> (try rfl)
    congr 1; funext v; congr 1; funext o; cases o <;> rfl
  have hl : Agent.from_rows_loop rows (alloc.vec.Vec.new Agent) true 0#usize ⦃ r => r.2 = true ∧ r.1.val = l ⦄ := by
    rw [e]; exact rows_loop Agent.from_row Agent.row (fun x v hv => Agent.from_row_spec x v hv) rows l h
  unfold Agent.from_rows
  step with hl
  simp [ok1_post, l_post]

theorem Family.from_rows_spec (rows : alloc.vec.Vec (alloc.vec.Vec Val)) (l : List Family)
    (h : rows.val.map (·.val) = l.map Family.row) :
    Family.from_rows rows ⦃ o => ∃ v, o = some v ∧ v.val = l ⦄ := by
  have e : Family.from_rows_loop rows (alloc.vec.Vec.new Family) true 0#usize =
      loop (fun x => rowsBody Family.from_row rows x.1 x.2.1 x.2.2) (alloc.vec.Vec.new Family, true, 0#usize) := by
    unfold Family.from_rows_loop; congr 1; funext ⟨a, b, c⟩
    simp only []; unfold Family.from_rows_loop.body rowsBody
    dsimp only
    split <;> (try rfl)
    congr 1; funext v; congr 1; funext o; cases o <;> rfl
  have hl : Family.from_rows_loop rows (alloc.vec.Vec.new Family) true 0#usize ⦃ r => r.2 = true ∧ r.1.val = l ⦄ := by
    rw [e]; exact rows_loop Family.from_row Family.row (fun x v hv => Family.from_row_spec x v hv) rows l h
  unfold Family.from_rows
