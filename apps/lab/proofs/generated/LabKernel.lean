def reported_score (best : Std.U64) (n : Std.U64) : Result Std.U64 := do
  if n <= 1#u64
  then ok best
  else
    if best = 0#u64
    then ok best
    else let pen ← n - 1#u64
         if pen >= best
         then ok 0#u64
         else best - pen

