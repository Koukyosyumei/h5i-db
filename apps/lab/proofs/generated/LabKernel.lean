    Visibility: public -/
def decode (r : Rows) : Result (Option Snapshot) := do
  let o ← Meta.from_one r.meta
  match o with
  | none => ok none
  | some x =>
    let o1 ← Agent.from_rows r.agents
    match o1 with
    | none => ok none
    | some x1 =>
      let o2 ← Family.from_rows r.families
      match o2 with
      | none => ok none
      | some x2 =>
        let o3 ← Pending.from_rows r.pendings
        match o3 with
        | none => ok none
        | some x3 =>
          let o4 ← Trial.from_rows r.trials
          match o4 with
          | none => ok none
          | some x4 =>
            let o5 ← Comment.from_rows r.comments
            match o5 with
            | none => ok none
            | some x5 =>
              let o6 ← Alert.from_rows r.alerts
              match o6 with
              | none => ok none
              | some x6 =>
                let o7 ← Text.from_rows r.texts
                match o7 with
                | none => ok none
                | some x7 =>
                  let o8 ← Curve.from_rows r.curves
                  match o8 with
                  | none => ok none
                  | some x8 =>
                    ok (some
                      {
                        «meta» := x,
                        agents := x1,
                        families := x2,
                        pendings := x3,
                        trials := x4,
                        comments := x5,
                        alerts := x6,
                        texts := x7,
                        curves := x8
                      })

