def apply_write (s : Snapshot) (w : Write) : Result Snapshot := do
  match w with
  | Write.SetMeta m => ok { s with «meta» := m }
  | Write.PutAgent a =>
    let v ← Agent.put s.agents a
    ok { s with agents := v }
  | Write.PutFamily f =>
    let v ← Family.put s.families f
    ok { s with families := v }
  | Write.PutPending p =>
    let v ← Pending.put s.pendings p
    ok { s with pendings := v }
  | Write.PutTrial t =>
    let v ← Trial.put s.trials t
    ok { s with trials := v }
  | Write.PutComment c =>
    let v ← Comment.put s.comments c
    ok { s with comments := v }
  | Write.PutAlert a =>
    let v ← Alert.put s.alerts a
    ok { s with alerts := v }
  | Write.PutText t => let v ← Text.put s.texts t
                       ok { s with texts := v }
  | Write.PutCurve c =>
    let v ← Curve.put s.curves c
    ok { s with curves := v }
  | Write.Emit _ => ok s

