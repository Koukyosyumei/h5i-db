def enroll
  (actor : Principal) (s : Snapshot) (agent : Std.U64) (budget : Std.U64)
  (token_budget : Std.U64) (sandbox : Std.U64) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  if actor.role != ROLE_HUMAN
  then ok (core.result.Result.Err Error.Forbidden)
  else
    if agent = 0#u64
    then ok (core.result.Result.Err Error.Invalid)
    else
      if sandbox != 0#u64
      then
        if sandbox != 1#u64
        then ok (core.result.Result.Err Error.Invalid)
        else
          let o ← find_agent s.agents agent
          match o with
          | none =>
            let v ←
              one (Write.PutAgent
                {
                  id := agent,
                  budget,
                  used := 0#u64,
                  token_budget,
                  tokens_used := 0#u64,
                  fork_id := agent,
                  sandbox
                })
            ok (core.result.Result.Ok (v, Reply.Created agent))
          | some _ => ok (core.result.Result.Err Error.Conflict)
      else
        let o ← find_agent s.agents agent
        match o with
        | none =>
          let v ←
            one (Write.PutAgent
              {
                id := agent,
                budget,
                used := 0#u64,
                token_budget,
                tokens_used := 0#u64,
                fork_id := agent,
                sandbox
              })
          ok (core.result.Result.Ok (v, Reply.Created agent))
        | some _ => ok (core.result.Result.Err Error.Conflict)

/-- [lab_kernel::pre_register]:
    Source: 'apps/lab/kernel/src/lib.rs', lines 301:0-333:1 -/
def pre_register
  (actor : Principal) (s : Snapshot) (hypothesis : Std.U64) (method : Std.U64)
  :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  if actor.role != ROLE_AGENT
  then ok (core.result.Result.Err Error.Forbidden)
  else
    if actor.agent = 0#u64
    then ok (core.result.Result.Err Error.Invalid)
    else
      if hypothesis = 0#u64
      then ok (core.result.Result.Err Error.Invalid)
      else
        if method = 0#u64
        then ok (core.result.Result.Err Error.Invalid)
        else
          let o ← find_agent s.agents actor.agent
          match o with
          | none => ok (core.result.Result.Err Error.NotFound)
          | some _ =>
            if s.meta.next_id = core.num.U64.MAX
            then ok (core.result.Result.Err Error.Overflow)
            else
              let i ← s.meta.next_id + 1#u64
              let v ←
                two (Write.PutFamily
                  {
                    id := s.meta.next_id,
                    agent := actor.agent,
                    task := s.meta.next_id,
                    hypothesis,
                    method,
                    trials := 0#u64,
                    best := 0#u64,
                    frozen_code := 0#u64,
                    frozen_params := 0#u64,
                    frozen_data := 0#u64,
                    holdout := HOLDOUT_NONE,
                    promoted := 0#u64
                  }) (Write.SetMeta { next_id := i })
              ok (core.result.Result.Ok (v, Reply.Created s.meta.next_id))

/-- [lab_kernel::request_trial]:
    Source: 'apps/lab/kernel/src/lib.rs', lines 335:0-399:1 -/
def request_trial
  (actor : Principal) (s : Snapshot) (family : Std.U64) (code : Std.U64)
  (params : Std.U64) (decision_time : Std.U64) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  if actor.role != ROLE_AGENT
  then ok (core.result.Result.Err Error.Forbidden)
  else
    if code = 0#u64
    then ok (core.result.Result.Err Error.Invalid)
    else
      let o ← find_family s.families family
      match o with
      | none => ok (core.result.Result.Err Error.NotFound)
      | some f =>
        if f.agent != actor.agent
        then ok (core.result.Result.Err Error.Forbidden)
        else
          let o1 ← find_agent s.agents actor.agent
          match o1 with
          | none => ok (core.result.Result.Err Error.NotFound)
          | some a =>
            if a.used >= a.budget
            then ok (core.result.Result.Err Error.Budget)
            else
              if s.meta.next_id = core.num.U64.MAX
              then ok (core.result.Result.Err Error.Overflow)
              else
                let i ← a.used + 1#u64
                let i1 ← s.meta.next_id + 1#u64
                let v ←
                  four (Write.PutPending
                    {
                      id := s.meta.next_id,
                      family,
                      agent := actor.agent,
                      code,
                      params,
                      decision_time,
                      «open» := 1#u64
                    }) (Write.PutAgent { a with used := i }) (Write.SetMeta
                    { next_id := i1 }) (Write.Emit
                    {
                      dest := DEST_DB,
                      kind := EFFECT_TRIAL,
                      id := s.meta.next_id
                    })
                ok (core.result.Result.Ok (v, Reply.Created s.meta.next_id))

/-- [lab_kernel::record_trial]:
    Source: 'apps/lab/kernel/src/lib.rs', lines 401:0-490:1 -/
def record_trial
  (actor : Principal) (s : Snapshot) (pending : Std.U64)
  (data_version : Std.U64) (score : Std.U64) (tokens : Std.U64) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  if actor.role != ROLE_WORKER
  then ok (core.result.Result.Err Error.Forbidden)
  else
    let o ← find_pending s.pendings pending
    match o with
    | none => ok (core.result.Result.Err Error.NotFound)
    | some p =>
      if p.open != 1#u64
      then ok (core.result.Result.Err Error.Conflict)
      else
        let o1 ← find_family s.families p.family
        match o1 with
        | none => ok (core.result.Result.Err Error.NotFound)
        | some f =>
          let o2 ← find_agent s.agents p.agent
          match o2 with
          | none => ok (core.result.Result.Err Error.NotFound)
          | some a =>
            let i ← core.num.U64.MAX - tokens
            if a.tokens_used > i
            then ok (core.result.Result.Err Error.Overflow)
            else
              let i1 ← a.tokens_used + tokens
              if i1 > a.token_budget
              then ok (core.result.Result.Err Error.Budget)
              else
                if f.trials = core.num.U64.MAX
                then ok (core.result.Result.Err Error.Overflow)
                else
                  let best ← if score > f.best
                               then ok score
                               else ok f.best
                  let i2 ← f.trials + 1#u64
                  let v ←
                    four (Write.PutPending { p with «open» := 0#u64 })
                      (Write.PutTrial
                      {
                        id := p.id,
                        family := p.family,
                        agent := p.agent,
                        code := p.code,
                        params := p.params,
                        data_version,
                        decision_time := p.decision_time,
                        score,
                        tokens
                      }) (Write.PutFamily { f with trials := i2, best })
                      (Write.PutAgent { a with tokens_used := i1 })
                  ok (core.result.Result.Ok (v, Reply.Ack))

